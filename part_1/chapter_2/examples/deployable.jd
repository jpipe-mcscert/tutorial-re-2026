
// jpipe process -f json -i deployable.jd -m deployable -o deployable.json
// jpipe process -f python -i deployable.jd -m deployable -o deployable.py
justification deployable {

    conclusion claim     is "The model is ready for deployment"
    strategy   threshold is "Confront the report's measurements to the 80% bar"

    sub-conclusion reporting   is "a report is available"
    strategy       execution   is "executing the model on the dataset"
    evidence       model       is "the model is available"
    evidence       training_ds is "the training dataset is available"

    threshold   supports claim
    reporting   supports threshold
    execution   supports reporting
    model       supports execution
    training_ds supports execution

}